# =====================================================================
# Telegram Media Downloader Bot Configuration
# =====================================================================

# 1. Telegram Bot Token from @BotFather (Required)
# Open Telegram -> @BotFather -> /newbot -> Copy API Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Pre-Download Threshold in Megabytes (Default: 100)
# Media files estimated above this size will ask before downloading:
# [Save to PC / Server Only] vs [Download & Send to Phone] vs [Cancel]
DELIVERY_THRESHOLD_MB=100

# 3. Maximum single upload chunk size in MB for phone delivery (Standard Telegram limit: 50MB)
MAX_FILE_SIZE_MB=50

# 4. Storage directory for downloaded media
DOWNLOAD_DIR=./downloads
